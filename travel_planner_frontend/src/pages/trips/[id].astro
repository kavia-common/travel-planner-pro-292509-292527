---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import ItineraryTimeline from '../../components/ItineraryTimeline.astro';
import Button from '../../components/ui/Button.astro';
import { getTripById, getTripItinerary, getTrips } from '../../lib/api';

export async function getStaticPaths() {
  const trips = await getTrips();
  return trips.map(trip => ({
    params: { id: trip.id },
  }));
}

const { id } = Astro.params;

if (!id) {
    return Astro.redirect('/dashboard');
}

const trip = await getTripById(id);
const itinerary = await getTripItinerary(id);

if (!trip) {
    return Astro.redirect('/404');
}

---

<DashboardLayout title={trip.title}>
    <div class="trip-header">
        <div class="trip-banner" style={`background-image: url(${trip.image})`}>
            <div class="overlay"></div>
            <div class="banner-content">
                <h1>{trip.title}</h1>
                <p class="destination-lg">
                    <span>📍 {trip.destination}</span>
                    <span class="dot">•</span>
                    <span>{new Date(trip.startDate).toLocaleDateString()} - {new Date(trip.endDate).toLocaleDateString()}</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="content-grid">
        <div class="main-column">
            <div class="section-header">
                <h3>Itinerary</h3>
                <Button variant="secondary" size="sm">+ Add Activity</Button>
            </div>
            
            <ItineraryTimeline items={itinerary} />
        </div>
        
        <div class="sidebar-column">
            <div class="card info-card">
                <h3>Trip Details</h3>
                <p>{trip.description || "No description provided."}</p>
                
                <div class="stats">
                    <div class="stat">
                        <span class="label">Duration</span>
                        <span class="value">
                            {Math.ceil((new Date(trip.endDate).getTime() - new Date(trip.startDate).getTime()) / (1000 * 60 * 60 * 24))} Days
                        </span>
                    </div>
                </div>
            </div>
            
            <div class="card action-card">
                <Button variant="outline" class="w-full mb-2">Edit Trip Details</Button>
                <Button variant="ghost" class="w-full text-error">Delete Trip</Button>
            </div>
        </div>
    </div>
</DashboardLayout>

<style>
    .trip-banner {
        height: 200px;
        border-radius: var(--radius-lg);
        background-size: cover;
        background-position: center;
        position: relative;
        margin-bottom: 2rem;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
    }
    
    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    }
    
    .banner-content {
        position: relative;
        z-index: 1;
        padding: 1.5rem;
        color: white;
    }
    
    .banner-content h1 {
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    
    .destination-lg {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1.1rem;
        opacity: 0.9;
    }
    
    .content-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    
    @media (min-width: 1024px) {
        .content-grid {
            grid-template-columns: 2fr 1fr;
        }
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--color-border);
    }
    
    .card {
        background: var(--color-surface);
        padding: 1.5rem;
        border-radius: var(--radius-lg);
        border: 1px solid var(--color-border);
        margin-bottom: 1.5rem;
    }
    
    .stats {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
    }
    
    .stat {
        display: flex;
        justify-content: space-between;
    }
    
    .label { color: var(--color-text-secondary); }
    .value { font-weight: 600; }
    
    .text-error { color: var(--color-error); }
    .w-full { width: 100%; }
    .mb-2 { margin-bottom: 0.5rem; }
</style>
