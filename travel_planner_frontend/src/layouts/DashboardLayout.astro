---
import Layout from './Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
}

const { title = 'Dashboard' } = Astro.props;
---

<Layout title={`${title} | Travel Planner`}>
  <div class="app-layout">
    <Sidebar />
    <div class="main-content-wrapper">
      <Header title={title} />
      <main class="main-content">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<style>
  .app-layout {
    display: flex;
    min-height: 100vh;
  }

  .main-content-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-left: 260px; /* Sidebar width */
    width: calc(100% - 260px);
  }
  
  .main-content {
      padding: 1.5rem;
      flex: 1;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
  }

  @media (max-width: 768px) {
    .main-content-wrapper {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

<script>
    // Simple script to handle mobile sidebar toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const sidebar = document.querySelector('.sidebar');
    
    if (menuBtn && sidebar) {
        menuBtn.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            // If we had a scrim/overlay we would toggle it here too
        });
        
        // Close sidebar when clicking outside on mobile would be good, 
        // but keeping it simple for now as requested.
    }
</script>
