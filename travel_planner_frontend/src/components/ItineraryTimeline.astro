---
import type { ItineraryItem } from '../types/travel';

interface Props {
  items: ItineraryItem[];
}

const { items } = Astro.props;

// Group by day
const groupedItems = items.reduce((acc, item) => {
    if (!acc[item.day]) acc[item.day] = [];
    acc[item.day].push(item);
    return acc;
}, {} as Record<number, ItineraryItem[]>);

// Sort days
const days = Object.keys(groupedItems).map(Number).sort((a, b) => a - b);

const getIcon = (type: string) => {
    switch(type) {
        case 'flight': return '✈️';
        case 'hotel': return '🏨';
        case 'food': return '🍽️';
        case 'activity': return '🎫';
        case 'transport': return '🚕';
        default: return '📍';
    }
}
---

<div class="timeline">
  {days.map(day => (
    <div class="day-group">
      <div class="day-header">Day {day}</div>
      <div class="day-items">
          {groupedItems[day].sort((a,b) => a.time.localeCompare(b.time)).map(item => (
            <div class="timeline-item">
              <div class="time-col">
                  <span class="time">{item.time}</span>
              </div>
              <div class="marker-col">
                  <div class="line"></div>
                  <div class="dot">{getIcon(item.type)}</div>
              </div>
              <div class="content-col">
                  <div class="activity-card">
                      <h4>{item.activity}</h4>
                      {item.location && <div class="location">📍 {item.location}</div>}
                      {item.description && <p class="desc">{item.description}</p>}
                  </div>
              </div>
            </div>
          ))}
      </div>
    </div>
  ))}
  
  {days.length === 0 && (
      <div class="empty-state">
          No itinerary items added yet.
      </div>
  )}
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem 0;
  }
  
  .day-header {
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 1rem;
      padding-left: 0.5rem;
      border-left: 4px solid var(--color-secondary);
  }
  
  .timeline-item {
      display: flex;
      gap: 1rem;
      position: relative;
      padding-bottom: 1.5rem;
  }
  
  .timeline-item:last-child {
      padding-bottom: 0;
  }
  
  .time-col {
      width: 80px;
      text-align: right;
      flex-shrink: 0;
  }
  
  .time {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text-secondary);
  }
  
  .marker-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 30px;
      position: relative;
  }
  
  .line {
      position: absolute;
      top: 0;
      bottom: -1.5rem; /* Extend to next item */
      width: 2px;
      background-color: var(--color-border);
      z-index: 1;
  }
  
  .timeline-item:last-child .line {
      display: none;
  }
  
  .dot {
      width: 32px;
      height: 32px;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      font-size: 1rem;
  }
  
  .content-col {
      flex: 1;
  }
  
  .activity-card {
      background-color: var(--color-surface);
      padding: 1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-sm);
  }
  
  .activity-card h4 {
      margin: 0 0 0.25rem 0;
      font-size: 1rem;
      color: var(--color-text-main);
  }
  
  .location {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
  }
  
  .desc {
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      margin: 0;
  }
  
  .empty-state {
      text-align: center;
      padding: 3rem;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border-radius: var(--radius-lg);
      border: 1px dashed var(--color-border);
  }
</style>
